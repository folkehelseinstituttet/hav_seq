#!/usr/bin/env Rscript
# Command-line version of the app's "compare" analysis.
#
#   Rscript cli/fhinumerics --query sequences.fasta [--out DIR] [--db NAME]
#                   [--neighbours 20] [--min-coverage 90] [--no-bootstrap]
#                   [--aligner mafft|decipher] [--search decipher|blast]
#                   [--threads 4] [--exclude-self] [--config config.yaml]
#   Rscript cli/fhinumerics --query-set SET_FOLDER [...]   (a saved set; its samples from
#                   the database searched leave out their own entry, as in the window)

args <- commandArgs(trailingOnly = TRUE)
file_arg <- sub("^--file=", "", grep("^--file=", commandArgs(FALSE), value = TRUE))
root <- normalizePath(file.path(dirname(file_arg), ".."))
options(fhinumerics.root = root)
for (f in list.files(file.path(root, "R"), full.names = TRUE)) source(f)

usage <- function() {
  cat(readLines(file_arg)[2:10], sep = "\n")
  quit(status = 1)
}
opt <- list(config = file.path(root, "config.yaml"))
i <- 1
while (i <= length(args)) {
  key <- args[i]
  if (key == "--no-bootstrap") { opt$bootstrap <- FALSE; i <- i + 1; next }
  if (key == "--exclude-self") { opt$exclude_self <- TRUE; i <- i + 1; next }
  if (key %in% c("-h", "--help") || i == length(args)) usage()
  opt[[sub("^--", "", key)]] <- args[i + 1]
  i <- i + 2
}
if (is.null(opt[["query"]]) == is.null(opt[["query-set"]])) usage()   # one of the two

cfg <- load_config(opt$config)
db <- if (is.null(opt$db)) cfg$databases[[1]] else cfg$databases[[opt$db]]
if (is.null(db)) stop("No database named '", opt$db, "' in ", opt$config)

settings <- cfg$settings %||% list()
if (!is.null(opt$neighbours)) settings$n_neighbours <- as.integer(opt$neighbours)
if (!is.null(opt[["min-coverage"]])) settings$min_coverage <- as.numeric(opt[["min-coverage"]])
if (!is.null(opt$threads)) settings$threads <- as.integer(opt$threads)
for (key in c("aligner", "search")) if (!is.null(opt[[key]])) settings[[key]] <- opt[[key]]
if (!is.null(opt$bootstrap)) settings$bootstrap <- opt$bootstrap
if (!is.null(opt$exclude_self)) settings$exclude_self <- TRUE

input <- NULL
if (!is.null(opt[["query-set"]])) {
  q <- set_queries(set_load(opt[["query-set"]]), db$name)
  queries <- q$seqs
  settings$exclude_self <- q$exclude_self
  input <- q$input
} else {
  queries <- read_fasta(opt[["query"]])
}
res <- run_compare(queries, db, cfg, settings, out_dir = opt$out,
                   progress = function(step, detail = NULL) message("== ", step), input = input)
cat(res$out_dir, "\n")
